#include "trimmer.h"

#include "config.h"
#include "ntsys.h"
#include "stats.h"

#include <psapi.h>

#include <atomic>
#include <chrono>
#include <condition_variable>
#include <cstdint>
#include <functional>
#include <iostream>
#include <mutex>
#include <queue>
#include <thread>
#include <unordered_map>
#include <vector>

namespace {

struct Due {
    std::int64_t ms;
    DWORD pid;
};
struct DueGreater {
    bool operator()(const Due& a, const Due& b) const { return a.ms > b.ms; }
};

std::mutex g_mtx;
std::condition_variable g_cv;
std::priority_queue<Due, std::vector<Due>, DueGreater> g_heap;
std::unordered_map<DWORD, HANDLE> g_handles;   /* pid -> proc handle */
std::atomic<DWORD> g_focusedPid{0};
std::atomic<bool>  g_run{false};
std::thread        g_sched;

std::int64_t NowMs()
{
    return std::chrono::duration_cast<std::chrono::milliseconds>(
        std::chrono::steady_clock::now().time_since_epoch()).count();
}

std::int64_t ClampInterval(std::int64_t ms)
{
    if (ms < 3000) return 3000;
    if (ms > 600000) return 600000;
    return ms;
}

/* Base interval modulated by system memory pressure. */
std::int64_t IntervalMs()
{
    std::int64_t base = (std::int64_t)config_get_int("TASX", "TrimIntervalSec", 10) * 1000;

    if (!config_get_bool("TASX", "AdaptiveTrim", 1))
        return ClampInterval(base);

    MEMORYSTATUSEX ms{};
    ms.dwLength = sizeof(ms);
    int load = 50;
    if (GlobalMemoryStatusEx(&ms))
        load = (int)ms.dwMemoryLoad;

    if (load >= 90) return ClampInterval(base / 4);   /* farm is choking RAM */
    if (load >= 75) return ClampInterval(base / 2);
    if (load <= 60) return ClampInterval(base * 2);   /* plenty of headroom */
    return ClampInterval(base);
}

void TrimOnce(HANDLE h)
{
    SetProcessWorkingSetSizeEx(h, (SIZE_T)-1, (SIZE_T)-1, 0);
    EmptyWorkingSet(h);
}

bool BelowSkipThreshold(DWORD pid)
{
    int skipMB = config_get_int("TASX", "TrimSkipBelowMB", 120);
    if (skipMB <= 0) return false;

    std::vector<ProcStat> stats;
    if (!QueryProcStats(stats)) return false;

    const SIZE_T limit = (SIZE_T)skipMB << 20;
    for (const auto& s : stats)
        if (s.pid == pid)
            return s.workingSet < limit;
    return false;
}

void SchedulerLoop()
{
    std::int64_t lastLog = NowMs();
    int trimmed = 0, skipped = 0;

    while (g_run.load())
    {
        std::unique_lock<std::mutex> lk(g_mtx);

        if (g_heap.empty()) {
            g_cv.wait(lk);
            continue;
        }

        std::int64_t due = g_heap.top().ms;
        g_cv.wait_until(lk, std::chrono::steady_clock::time_point(
                                std::chrono::milliseconds(due)));

        if (g_heap.empty()) continue;
        if (g_heap.top().ms > NowMs()) continue;   /* woken by an earlier push */

        Due d = g_heap.top();
        g_heap.pop();
        lk.unlock();

        DWORD pid = d.pid;

        if (g_focusedPid.load() == pid) {
            std::lock_guard<std::mutex> rel(g_mtx);
            g_heap.push({NowMs() + 3000, pid});    /* never fight the player */
            continue;
        }

        HANDLE h = nullptr;
        {
            std::lock_guard<std::mutex> rel(g_mtx);
            auto it = g_handles.find(pid);
            if (it != g_handles.end()) h = it->second;
        }

        if (h) {
            if (BelowSkipThreshold(pid)) {
                ++skipped;                          /* already small: 0 syscalls */
            }
            else {
                TrimOnce(h);
                ++trimmed;
            }

            lk.lock();
            g_heap.push({NowMs() + IntervalMs(), pid});
        }
        else {
            lk.lock(); /* stale entry (client released): drop, no re-push */
        }

        std::int64_t now = NowMs();
        if (now - lastLog >= 30000) {              /* lk already held here */
            std::cout << "[Trimmer] " << g_handles.size() << " client(s), "
                      << trimmed << " trimmed, " << skipped
                      << " skipped (30s)" << std::endl;
            lastLog = now;
            trimmed = 0;
            skipped = 0;
        }
    }
}

} /* namespace */

void TrimmerSetFocused(DWORD pid)
{
    g_focusedPid.store(pid ? pid : 0);
}

bool StartTrimmer(DWORD pid, HANDLE processHandle)
{
    if (!config_get_bool("TASX", "TrimUnfocused", 1))
        return false; /* trimming globally disabled via TASX.ini */

    bool needStart = false;
    {
        std::lock_guard<std::mutex> lock(g_mtx);
        if (g_handles.count(pid)) return true;

        g_handles[pid] = processHandle;
        g_heap.push({NowMs() + IntervalMs(), pid});
        needStart = !g_sched.joinable();
    }

    if (needStart) {
        g_run.store(true);
        g_sched = std::thread(SchedulerLoop);
    }

    g_cv.notify_one();
    return true;
}

void StopTrimmer(DWORD pid)
{
    std::lock_guard<std::mutex> lock(g_mtx);
    g_handles.erase(pid); /* heap entry is skipped lazily on pop */
}

void TrimmerTrimAll()
{
    std::vector<HANDLE> targets;
    DWORD focused = g_focusedPid.load();

    {
        std::lock_guard<std::mutex> lock(g_mtx);
        for (auto& kv : g_handles)
            if (kv.first != focused)
                targets.push_back(kv.second);
    }

    for (HANDLE h : targets) TrimOnce(h);
}

void StopAllTrimmers()
{
    if (g_run.exchange(false) && g_sched.joinable())
        g_sched.join();

    std::lock_guard<std::mutex> lock(g_mtx);
    g_handles.clear();
    while (!g_heap.empty()) g_heap.pop();
}
