#include "winhook.h"

#include <iostream>
#include <thread>

std::atomic<DWORD> WinHook::s_foregroundPid{0};

WinHook::~WinHook()
{
    if (m_hook) UnhookWinEvent(m_hook);
    if (m_pumpThread) {
        PostThreadMessageW(m_pumpThreadId, WM_QUIT, 0, 0);
        WaitForSingleObject(m_pumpThread, 2000);
        CloseHandle(m_pumpThread);
    }
}

DWORD WinHook::ForegroundPid()
{
    return s_foregroundPid.load();
}

void WinHook::Start()
{
    m_pumpThread = CreateThread(
        nullptr, 0,
        [](LPVOID self) -> DWORD {
            auto* hook = static_cast<WinHook*>(self);

            hook->m_hook = SetWinEventHook(
                EVENT_SYSTEM_FOREGROUND, EVENT_SYSTEM_FOREGROUND,
                nullptr, HookCallback,
                0, 0,
                WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS);

            if (!hook->m_hook) {
                std::cout << "[TASX] Foreground hook unavailable, polling only"
                          << std::endl;
                return 0;
            }

            /* GetMessageW pumps events to the hook callback until WM_QUIT. */
            MSG msg;
            while (GetMessageW(&msg, nullptr, 0, 0) > 0) { /* drain */ }

            return 0;
        },
        this, 0, &m_pumpThreadId);

    if (!m_pumpThread)
        std::cout << "[TASX] Failed to start foreground hook pump" << std::endl;
}

void CALLBACK WinHook::HookCallback(HWINEVENTHOOK, DWORD, HWND hwnd,
                                    LONG, LONG, DWORD, DWORD)
{
    DWORD pid = 0;
    GetWindowThreadProcessId(hwnd, &pid);
    s_foregroundPid.store(pid);
    NotifyFocusChanged();
}
